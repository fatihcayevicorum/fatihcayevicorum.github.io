rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'obuZLQXuPAWsHE20bZxcAxCNsO02';
    }
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staffUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/staffUsers/$(request.auth.uid)).data.active == true;
    }
    function isManager() {
      return isOwner() || isStaff();
    }
    function hasPanel(panel) {
      return isOwner() || (isStaff()
        && get(/databases/$(database)/documents/staffUsers/$(request.auth.uid)).data.permissions.hasAny([panel]));
    }
    function hasAnyPanel(panels) {
      return isOwner() || (isStaff()
        && get(/databases/$(database)/documents/staffUsers/$(request.auth.uid)).data.permissions.hasAny(panels));
    }
    function isActiveMerchant() {
      return request.auth != null
        && exists(/databases/$(database)/documents/merchantProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/merchantProfiles/$(request.auth.uid)).data.active == true;
    }
    function financeDateOpen(date) {
      return date is string
        && date >= '2026-08-13'
        && (!exists(/databases/$(database)/documents/adminFinanceDays/$(date))
          || get(/databases/$(database)/documents/adminFinanceDays/$(date)).data.locked != true);
    }
    function validFinanceMovement(data) {
      return data.type in ['income', 'expense', 'transfer']
        && data.amount is number
        && data.amount > 0
        && financeDateOpen(data.businessDate)
        && ((data.type == 'income' && data.account in ['cash', 'bank', 'card'])
          || (data.type == 'expense' && data.account in ['cash', 'bank', 'creditCard'])
          || (data.type == 'transfer'
            && data.fromAccount in ['cash', 'bank', 'card', 'creditCard']
            && data.toAccount in ['cash', 'bank', 'card', 'creditCard']
            && data.fromAccount != data.toAccount));
    }
    function validPosInstantMovement(data) {
      return data.type == 'income'
        && data.amount is number
        && data.amount >= 0
        && financeDateOpen(data.businessDate)
        && data.account in ['cash', 'bank', 'card']
        && data.category == 'Günlük Gelir'
        && data.automatic == true
        && data.source == 'pos-instant'
        && data.sourceGroup == 'income'
        && data.cashMovementVersion == 'r178-unified-income';
    }
    function isPosInstantDocument(document, account) {
      return (account == 'cash' && document.matches('pos-gelir-cash-.*'))
        || (account == 'bank' && document.matches('pos-gelir-bank-.*'))
        || (account == 'card' && document.matches('pos-gelir-card-.*'));
    }

    match /staffUsers/{uid} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == uid);
      allow write: if isOwner();
    }
    match /staffUserAudit/{document} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /adminPersonnel/{document} {
      allow read: if hasPanel('reports');
      allow write: if isOwner();
    }
    match /adminPersonnelAttendance/{document} {
      allow read: if hasPanel('reports');
      allow write: if isOwner();
    }
    match /adminPersonnelPayments/{document} {
      allow read: if hasPanel('reports');
      allow write: if isOwner();
    }
    match /adminSecurity/{document} {
      allow read, write: if false;
    }
    match /sensitivePinAttempts/{document} {
      allow read, write: if false;
    }

    match /publicTea/status {
      allow read: if true;
      allow write: if hasAnyPanel(['tea', 'pos']);
    }
    match /adminTea/{document} {
      allow read, write: if hasAnyPanel(['tea', 'pos']);
    }
    match /publicMenu/catalog {
      allow read: if true;
      allow write: if hasPanel('menu');
    }
    match /publicSite/config {
      allow read: if true;
      allow write: if hasPanel('home');
    }
    match /publicSite/stats {
      allow read: if true;
      allow create: if request.resource.data.totalVisits == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['totalVisits', 'updatedAt'])
        && request.resource.data.totalVisits == resource.data.totalVisits + 1;
    }
    match /publicPresence/{sessionId} {
      allow read: if true;
      allow create, update: if request.resource.data.lastSeenMs is int;
      allow delete: if false;
    }
    match /adminStockItems/{document} {
      allow read: if hasAnyPanel(['stock', 'pos', 'reports']);
      allow write: if hasAnyPanel(['stock', 'pos'])
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0;
    }
    match /adminStockMovements/{document} {
      allow read: if hasAnyPanel(['stock', 'pos', 'reports']);
      allow write: if hasAnyPanel(['stock', 'pos']);
    }
    match /adminPurchaseOrders/{document} {
      allow read, write: if hasPanel('stock');
    }
    match /adminCreditCustomers/{document} {
      allow read: if hasAnyPanel(['credit', 'pos', 'reports']);
      allow write: if hasAnyPanel(['credit', 'pos']);
    }
    match /adminCreditMovements/{document} {
      allow read: if hasAnyPanel(['credit', 'pos', 'reports']);
      allow write: if hasAnyPanel(['credit', 'pos']);
    }
    match /adminAppSettings/{document} {
      allow read: if isManager();
      allow write: if hasAnyPanel(['pos', 'reports', 'cash']);
    }
    match /adminOrders/{document} {
      allow read, write: if hasPanel('pos');
    }
    match /adminSales/{document} {
      allow read: if hasAnyPanel(['pos', 'reports', 'merchant', 'cash']);
      allow write: if hasAnyPanel(['pos', 'reports', 'merchant']);
    }
    match /adminDailyClosings/{document} {
      allow read: if hasAnyPanel(['reports', 'pos', 'cash']);
      allow write: if hasAnyPanel(['reports', 'pos']);
    }
    match /adminInternalConsumptions/{document} {
      allow read: if hasAnyPanel(['pos', 'reports']);
      allow write: if hasPanel('pos');
    }
    match /adminCashMovements/{document} {
      allow get: if hasAnyPanel(['cash', 'reports'])
        || (hasPanel('pos') && document.matches('pos-gelir-(cash|bank|card)-.*'));
      allow list: if hasAnyPanel(['cash', 'reports']);
      allow create: if (validFinanceMovement(request.resource.data) && (hasPanel('cash') || (hasPanel('pos')
          && request.resource.data.source == 'pos-quick-cash'
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.account in ['cash', 'bank', 'card', 'creditCard']
          && request.resource.data.automatic == false)
          || (hasPanel('stock')
          && request.resource.data.source == 'stock-purchase'
          && request.resource.data.type == 'expense'
          && request.resource.data.amount is number
          && request.resource.data.amount > 0)))
        || (hasPanel('pos')
          && validPosInstantMovement(request.resource.data)
          && request.resource.data.amount > 0
          && isPosInstantDocument(document, request.resource.data.account));
      allow update: if financeDateOpen(resource.data.businessDate)
        && request.resource.data.businessDate == resource.data.businessDate
        && ((hasPanel('cash') && validFinanceMovement(request.resource.data))
          || (hasPanel('pos')
            && resource.data.source == 'pos-instant'
            && resource.data.automatic == true
            && validPosInstantMovement(request.resource.data)
            && isPosInstantDocument(document, request.resource.data.account)
            && request.resource.data.account == resource.data.account
            && request.resource.data.type == resource.data.type
            && request.resource.data.sourceGroup == resource.data.sourceGroup
            && request.resource.data.cashMovementVersion == resource.data.cashMovementVersion));
      allow delete: if hasPanel('cash')
        && financeDateOpen(resource.data.businessDate);
    }
    match /adminFinanceDays/{businessDate} {
      allow read: if hasAnyPanel(['cash', 'pos', 'reports']);
      allow create: if hasPanel('cash')
        && businessDate >= '2026-08-13'
        && request.resource.data.businessDate == businessDate
        && request.resource.data.locked == true;
      allow update, delete: if false;
    }
    match /adminCashSettings/{document} {
      allow read, write: if hasPanel('cash');
    }
    match /adminCashCounts/{document} {
      allow read, write: if hasPanel('cash');
    }
    match /adminPaymentReminders/{document} {
      allow read, write: if hasPanel('cash');
    }

    match /merchantProfiles/{merchantId} {
      allow read: if hasPanel('merchant')
        || (request.auth != null && request.auth.uid == merchantId);
      allow create, update, delete: if hasPanel('merchant');
    }
    match /merchantBalanceMovements/{movementId} {
      allow read: if hasPanel('merchant')
        || (request.auth != null && resource.data.merchantId == request.auth.uid);
      allow create, update, delete: if hasPanel('merchant');
    }
    match /merchantOrders/{orderId} {
      allow read: if hasPanel('merchant')
        || (request.auth != null && resource.data.merchantId == request.auth.uid);
      allow create: if isActiveMerchant()
        && request.resource.data.merchantId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 50;
      allow update: if hasPanel('merchant')
        || (isActiveMerchant()
          && resource.data.merchantId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledAt', 'updatedAt']));
      allow delete: if hasPanel('merchant');
    }

    match /adminTeaPushDevices/{deviceId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 20
        && request.resource.data.token.size() <= 4096
        && request.resource.data.active is bool;
      allow update: if isOwner()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token == resource.data.token
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'active', 'deviceType', 'platform', 'userAgent', 'createdAtMs',
          'updatedAtMs', 'updatedAt'
        ]);
      allow delete: if false;
    }
    match /adminTeaNotificationEvents/{document} {
      allow read, write: if false;
    }
    match /merchantPushDevices/{deviceId} {
      allow read: if isOwner()
        || (isActiveMerchant() && resource.data.merchantId == request.auth.uid);
      allow create: if isActiveMerchant()
        && request.resource.data.merchantId == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 20
        && request.resource.data.token.size() <= 4096
        && request.resource.data.active is bool;
      allow update: if isActiveMerchant()
        && resource.data.merchantId == request.auth.uid
        && request.resource.data.merchantId == request.auth.uid
        && request.resource.data.token == resource.data.token
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'active', 'preferences', 'deviceType', 'platform', 'userAgent',
          'createdAtMs', 'updatedAtMs', 'updatedAt'
        ]);
      allow delete: if false;
    }
    match /merchantBroadcastRequests/{requestId} {
      allow read, create: if isOwner();
      allow update, delete: if false;
    }
    match /adminInAppNotifications/{notificationId} {
      allow read: if isManager();
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'readAtMs', 'updatedAt']);
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
