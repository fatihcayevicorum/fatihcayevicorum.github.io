rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function backupWritable() {
      return !firestore.exists(/databases/(default)/documents/adminBackupControl/state)
        || firestore.get(/databases/(default)/documents/adminBackupControl/state).data.active != true;
    }
    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if backupWritable() && (request.auth != null
        && (
          request.auth.uid == 'obuZLQXuPAWsHE20bZxcAxCNsO02'
          || (
            firestore.get(/databases/(default)/documents/staffUsers/$(request.auth.uid)).data.active == true
            && firestore.get(/databases/(default)/documents/staffUsers/$(request.auth.uid)).data.permissions.hasAny(['home'])
          )
        )
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*'));
    }
    match /system-backups/{backupFile} {
      allow read: if request.auth != null
        && request.auth.uid == 'obuZLQXuPAWsHE20bZxcAxCNsO02';
      allow delete: if backupWritable() && (request.auth != null
        && request.auth.uid == 'obuZLQXuPAWsHE20bZxcAxCNsO02');
      allow create, update: if backupWritable() && (request.auth != null
        && request.auth.uid == 'obuZLQXuPAWsHE20bZxcAxCNsO02'
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType == 'application/json');
    }
    // R575: temporary upload chunks only. Final backup parts remain server-only.
    match /system-backups/uploads/{uploadId}/{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.uid == 'obuZLQXuPAWsHE20bZxcAxCNsO02';
      allow write: if backupWritable() && (request.auth != null
        && request.auth.uid == 'obuZLQXuPAWsHE20bZxcAxCNsO02'
        && uploadId.matches('[a-f0-9-]{36}')
        && request.resource.size <= 16 * 1024 * 1024
        && request.resource.contentType.matches('application/(json|octet-stream)'));
    }
    // R624: firmware yüklemesi yalnız ana yönetici; cihaz indirmesi sunucu
    // fonksiyonu üzerinden cihaz anahtarı ve bekleyen istek doğrulanarak yapılır.
    match /boiler-firmware/releases/{firmwareFile} {
      allow read: if false;
      allow create, update: if backupWritable() && (request.auth != null
        && request.auth.uid == 'obuZLQXuPAWsHE20bZxcAxCNsO02'
        && firmwareFile.matches('[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?\\.bin')
        && request.resource.size >= 64 * 1024
        && request.resource.size <= 4 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream');
      allow delete: if backupWritable() && (request.auth != null
        && request.auth.uid == 'obuZLQXuPAWsHE20bZxcAxCNsO02');
    }
    match /{allPaths=**} {
      allow read: if false;
      allow write: if backupWritable() && (false);
    }
  }
}
