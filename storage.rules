rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && (
          request.auth.uid == 'obuZLQXuPAWsHE20bZxcAxCNsO02'
          || (
            firestore.get(/databases/(default)/documents/staffUsers/$(request.auth.uid)).data.active == true
            && firestore.get(/databases/(default)/documents/staffUsers/$(request.auth.uid)).data.permissions.hasAny(['home'])
          )
        )
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /system-backups/{backupFile} {
      allow read, delete: if request.auth != null
        && request.auth.uid == 'obuZLQXuPAWsHE20bZxcAxCNsO02';
      allow create, update: if request.auth != null
        && request.auth.uid == 'obuZLQXuPAWsHE20bZxcAxCNsO02'
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/json';
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
